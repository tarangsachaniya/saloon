# Copy this file to `.env.local` and adjust for your environment.
#
# The API is part of this Next.js app now (app/api/**/route.ts), so the browser
# calls its own origin and there is no separate backend host to point at.
# A relative base is the default and works in dev, preview and production.
NEXT_PUBLIC_API_URL=/api

# Only set an absolute URL if the browser must talk to a DIFFERENT deployment
# of this app (which also means re-introducing CORS on that deployment):
# NEXT_PUBLIC_API_URL=https://staging.example.com/api

# Public origin of the site, used to make share-card (og:image) URLs absolute.
# NEXT_PUBLIC_SITE_URL=https://salon.priinteve.com

# Server-side variables (DATABASE_URL, JWT_SECRET, ...) live in `.env` - see
# `.env` in this directory for the local development values.

# Google sign-in ("Continue with Google"). Create an OAuth client (type: Web) at
# https://console.cloud.google.com/apis/credentials and add these redirect URIs:
#   http://localhost:3000/api/auth/google/callback      (development)
#   https://<your-domain>/api/auth/google/callback      (production)
# Put the real values in `.env` / your host's env settings - never in source code.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL (defaults to <site origin>/api/auth/google/callback).
# GOOGLE_REDIRECT_URI=

# Optional heads-up email when someone submits a salon listing request.
# The request always shows in the platform admin (Salon requests) either way.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Salonly <no-reply@your-domain>"
# ADMIN_NOTIFY_EMAIL=
# NEXT_PUBLIC_SITE_URL=https://your-domain
