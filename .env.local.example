# Copy this file to `.env.local` and adjust for your environment.
#
# The API is part of this Next.js app now (app/api/**/route.ts), so the browser
# calls its own origin and there is no separate backend host to point at.
# A relative base is the default and works in dev, preview and production.
NEXT_PUBLIC_API_URL=/api

# Only set an absolute URL if the browser must talk to a DIFFERENT deployment
# of this app (which also means re-introducing CORS on that deployment):
# NEXT_PUBLIC_API_URL=https://staging.example.com/api

# Server-side variables (DATABASE_URL, JWT_SECRET, ...) live in `.env` - see
# `.env` in this directory for the local development values.
