// Prisma schema for the multi-salon booking platform.
// Every tenant-owned table carries a `salonId`; see lib/server/salon.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
  CUSTOMER
}

/// Look of a salon's public shop page. One page, four skins (see lib/themes.ts).
enum SalonTheme {
  SPA
  CUT
  PLAYFUL
  LUXE
}

enum BillingPlanType {
  MONTHLY
  COMMISSION
}

enum CommissionType {
  PERCENT
  FLAT
}

enum StatementStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

/// Worker commission payout state. Ready for future payout tooling.
enum WorkerCommissionStatus {
  PENDING
  PAID
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum PolicyType {
  TERMS
  PRIVACY
  CANCELLATION
  CONSENT
}

/// A tenant: one salon with its own shop page, staff, catalogue and bookings.
model Salon {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  tagline     String?
  about       String?
  logoUrl     String?
  coverUrl    String?
  gallery     String[]
  theme       SalonTheme @default(SPA)
  accentColor String?
  phone       String?
  email       String?
  address     String?
  mapUrl      String?
  socials     Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  settings     SalonSettings?
  openingHours SalonOpeningHour[]
  barbers      Barber[]
  services     Service[]
  clients      Client[]
  appointments Appointment[]
  users        User[]
  policies     SalonPolicy[]
  billingPlans SalonBillingPlan[]
  statements   BillingStatement[]
  Review       Review[]
  commissions  WorkerCommission[]
}

/// What the platform charges a salon. Plans are versioned: a change inserts a
/// new row (latest `effectiveFrom` wins) so past statements stay reproducible.
model SalonBillingPlan {
  id              String          @id @default(uuid())
  salonId         String
  salon           Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  planType        BillingPlanType
  /// MONTHLY: fixed fee per month.
  monthlyFee      Decimal?        @db.Decimal(10, 2)
  /// COMMISSION: PERCENT of completed-appointment value, or FLAT per completed booking.
  commissionType  CommissionType?
  /// PERCENT: 0-100 (e.g. 12.50). FLAT: currency amount per completed booking.
  commissionValue Decimal?        @db.Decimal(10, 2)
  currency        String          @default("INR")
  effectiveFrom   DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([salonId, effectiveFrom])
}

model BillingStatement {
  id                String          @id @default(uuid())
  salonId           String
  salon             Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  periodStart       DateTime        @db.Date
  periodEnd         DateTime        @db.Date
  planSnapshot      Json
  completedBookings Int
  grossRevenue      Decimal         @db.Decimal(12, 2)
  amountDue         Decimal         @db.Decimal(12, 2)
  status            StatementStatus @default(DRAFT)
  paidAt            DateTime?
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([salonId, periodStart])
}

/// Owner-editable policy text shown on the salon's shop page.
model SalonPolicy {
  id        String     @id @default(uuid())
  salonId   String
  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  type      PolicyType
  body      String
  version   Int        @default(1)
  updatedAt DateTime   @updatedAt

  @@unique([salonId, type])
}

/// Per-salon booking policy (profile fields live on `Salon`).
model SalonSettings {
  id                           Int      @id @default(autoincrement())
  salonId                      String   @unique
  salon                        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  slotIntervalMinutes          Int      @default(15)
  minimumAdvanceBookingMinutes Int      @default(30)
  maximumAdvanceBookingDays    Int      @default(30)
  cancellationWindowMinutes    Int      @default(60)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

/// One row per weekday (0=Sunday..6=Saturday) for the salon's own hours.
model SalonOpeningHour {
  id        Int     @id @default(autoincrement())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  weekday   Int
  isOpen    Boolean @default(true)
  openTime  Int
  closeTime Int

  @@unique([salonId, weekday])
}

model Barber {
  id                   String   @id @default(uuid())
  salonId              String
  salon                Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name                 String
  phone                String?
  email                String?
  photo                String?
  bio                  String?
  specializations      String[]
  isActive             Boolean  @default(true)
  /// Share of each completed service the worker earns (0-100). INTERNAL: omitted
  /// from every query by default (see lib/server/prisma.ts); only the owner
  /// commission routes opt in.
  commissionPercentage Decimal  @default(0) @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  commissions  WorkerCommission[]
  services     Service[]           @relation("BarberServices")
  workingHours BarberWorkingHour[]
  breaks       BarberBreak[]
  daysOff      BarberDayOff[]
  appointments Appointment[]
}

/// One row per barber per weekday.
model BarberWorkingHour {
  id        String  @id @default(uuid())
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday   Int
  isWorking Boolean @default(true)
  startTime Int
  endTime   Int

  @@unique([barberId, weekday])
}

/// A recurring weekly break (e.g. lunch) for a barber.
model BarberBreak {
  id        String  @id @default(uuid())
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime Int
  endTime   Int
  label     String?
}

/// A one-off day the barber is unavailable (holiday, leave, etc.).
model BarberDayOff {
  id       String   @id @default(uuid())
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  reason   String?

  @@unique([barberId, date])
}

model Service {
  id              String   @id @default(uuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  category        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barbers      Barber[]      @relation("BarberServices")
  appointments Appointment[]
}

model Client {
  id          String    @id @default(uuid())
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  notes       String?
  totalVisits Int       @default(0)
  lastVisit   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments Appointment[]

  @@unique([salonId, phone])
}

model Appointment {
  id              String            @id @default(uuid())
  salonId         String
  salon           Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  barberId        String
  barber          Barber            @relation(fields: [barberId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  appointmentDate DateTime          @db.Date
  startTime       Int
  endTime         Int
  durationMinutes Int
  price           Decimal           @db.Decimal(10, 2)
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  /// Data-processing consent captured at booking (DPDP / GDPR-style record).
  consentAt       DateTime?
  consentVersion  String?
  marketingOptIn  Boolean           @default(false)
  /// Random one-time token letting the (unauthenticated) customer review after COMPLETED.
  /// The signed-in customer who booked (null for guest bookings and everything
  /// booked before accounts existed). The ONLY basis for "my appointments":
  /// matching on the phone number would let anyone claim a number they don't own.
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewToken     String?           @unique
  commission      WorkerCommission?
  review          Review?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // NOTE: a generated `slotRange tsrange` column + a Postgres EXCLUDE USING gist
  // constraint on (barberId, slotRange) WHERE status NOT IN (CANCELLED, NO_SHOW)
  // is added via a hand-written migration (see prisma/migrations/*_add_overlap_exclusion).
  // That column/constraint is intentionally NOT modeled here - Prisma's schema
  // language cannot express generated columns or exclusion constraints, and the
  // app never needs to read that column directly.

  @@index([barberId, appointmentDate])
  @@index([clientId])
  @@index([salonId, appointmentDate])
  @@index([userId, appointmentDate])
}

/// Single auth table: platform admins, salon owners/staff and (Phase 1) customers.
/// Customers have salonId = null and role CUSTOMER (the default).
model User {
  id               String        @id @default(uuid())
  firstName        String
  lastName         String?
  email            String        @unique
  password         String
  phoneNumber      String?
  /// Null for SUPER_ADMIN (platform-level); required for OWNER/STAFF.
  salonId          String?
  salon            Salon?        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  role             UserRole      @default(CUSTOMER)
  /// DEPRECATED - 2FA was removed from the app. Columns are kept (unused, safe
  /// defaults) so no migration touches existing rows; drop in a later migration.
  twoFactorEnabled Boolean       @default(false)
  twoFactorSecret  String?
  /// Google account id (OIDC `sub`), set only after the user proves ownership of the
  /// Salonly account (new Google sign-up, or password-confirmed linking).
  googleId         String?       @unique
  enabled          Boolean       @default(true)
  passToken        String?
  devices          Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  Appointment      Appointment[]
}

/// One customer review per completed appointment, shown on the salon page.
model Review {
  id            String       @id @default(uuid())
  salonId       String
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  authorName    String
  status        ReviewStatus @default(PUBLISHED)
  ownerReply    String?
  repliedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([salonId, status, createdAt])
}

/// A "list your salon" enquiry from the marketing site. Platform-level (no salonId).
model PlatformLead {
  id             String     @id @default(uuid())
  name           String
  salonName      String
  email          String
  phone          String?
  city           String?
  message        String?
  status         LeadStatus @default(NEW)
  consentAt      DateTime
  consentVersion String
  createdAt      DateTime   @default(now())

  @@index([status, createdAt])
}

/// One row per COMPLETED appointment (unique appointmentId = no duplicates, ever).
/// Percentage and amounts are SNAPSHOTS taken at completion: later changes to the
/// worker's percentage or the service price never rewrite history.
model WorkerCommission {
  id                   String                 @id @default(uuid())
  appointmentId        String                 @unique
  appointment          Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barberId             String
  barber               Barber                 @relation(fields: [barberId], references: [id])
  salonId              String
  salon                Salon                  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  commissionPercentage Decimal                @db.Decimal(5, 2)
  serviceAmount        Decimal                @db.Decimal(10, 2)
  commissionAmount     Decimal                @db.Decimal(10, 2)
  status               WorkerCommissionStatus @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime               @default(now())

  @@index([salonId, barberId, status])
  @@index([salonId, createdAt])
}
